# Copy this file to .env and replace the JWT secret with a random value.
GEOSENTRY_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Defaults to geosentry-backend/geosentry.db when unset. A custom SQLite URL
# can be set here; existing databases are never recreated or deleted.
# GEOSENTRY_DATABASE_URL=sqlite:///C:/path/to/geosentry.db

# Configure a provider collection endpoint in the backend environment.
# Leave unset until a real GPS provider is available; GeoSentry will report
# telemetry as unavailable and will not substitute simulated coordinates.
TELEMETRY_BASE_URL=

# Path appended to TELEMETRY_BASE_URL. {external_id} is URL-encoded server-side.
TELEMETRY_PATH_TEMPLATE=/{external_id}
TELEMETRY_TIMEOUT_SECONDS=10

# The previous setting name remains supported for existing deployments:
# GEOSENTRY_TELEMETRY_API_BASE_URL=
# GEOSENTRY_TELEMETRY_TIMEOUT_SECONDS=10
